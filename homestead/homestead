#!/usr/bin/env fish

argparse -n homestead -s "h/help" "u" "s" "no-cwd" -- $argv
or exit 1

if set -q _flag_help
    echo "\
Usage: homestead [OPTIONS] COMMAND...

Isolate changes to your home directory.

Runs a command in a named sandbox. Everything in the current working directory
is writeable as normal, but other files in your home directory are read-only,
except for: TODO

Options:
  --no-cwd      don't pass the current directory through the sandbox
  -s            isolate more things (PIDs, IPC, cgroup, /proc, /tmp)
  -h, --help    show this help text"
    exit
end

set bwrap_args \
    --die-with-parent \
    --bind / / \
    --dev-bind /dev /dev \
    --ro-bind $HOME $HOME

if not set -q XDG_CACHE_HOME; set XDG_CACHE_HOME $HOME/.cache; end
if not set -q XDG_DATA_HOME; set XDG_DATA_HOME $HOME/.local/share; end

set passthrough $XDG_CACHE_HOME $XDG_DATA_HOME/fish

set cwd (pwd)
if not set -q _flag_no_cwd
    set -a passthrough $cwd
end

for dir in $passthrough
    if test -d $dir
        set -a bwrap_args --bind $dir $dir
    end
end

bwrap \
    $bwrap_args \
    -- $argv
